# PostgreSQL / Supabase connection URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Keep true for databases with a publicly trusted CA. Set false only when the
# managed provider presents a private/self-signed certificate chain.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Long, randomly generated signing secret.
AUTH_JWT_SECRET=replace-with-a-long-random-secret

# One deployed frontend URL, or a comma-separated CORS allowlist.
FRONTEND_URL=https://your-project.vercel.app

# Development seed password only.
SEED_PASSWORD=replace-with-a-development-seed-password
