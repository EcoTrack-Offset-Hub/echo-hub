# Copy to backend/.env and replace placeholders. Never commit backend/.env.
# Copy this string from Supabase Dashboard > Connect. Preserve its pooler host and port.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=verify-full
# Download the database root certificate from Supabase Dashboard > Database Settings.
# Store it outside the repository and provide its absolute path only on the backend host.
SUPABASE_SSL_ROOT_CERT_PATH=C:\Users\ACCER\Downloads\prod-ca-2021.crt
AUTH_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional local demonstration password for the three seeded test users.
SEED_PASSWORD=EcoTrackDemo!2026
