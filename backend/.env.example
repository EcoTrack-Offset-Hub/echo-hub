# PostgreSQL / Supabase connection URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Optional path to the Supabase SSL root certificate.
SUPABASE_SSL_ROOT_CERT_PATH=/path/to/supabase-ca.crt

# Long, randomly generated signing secret.
AUTH_JWT_SECRET=replace-with-a-long-random-secret

# Development seed password only.
SEED_PASSWORD=replace-with-a-development-seed-password
