{
  "name": "ecotrack-backend",
  "version": "1.0.0",
  "description": "EcoTrack Hub authoritative emissions calculation & PostgreSQL persistence backend API",
  "main": "server.js",
  "scripts": {
    "test:automated": "node --use-system-ca tests/run-automated.js",
    "test:excel": "node --use-system-ca tests/excel-api-cases.test.js",
    "start": "node --use-system-ca server.js",
    "dev": "node --watch --use-system-ca server.js",
    "test": "node --use-system-ca tests/role-permissions.test.js && node --use-system-ca tests/company-management.test.js && node --use-system-ca tests/dashboard-metrics.test.js && node --use-system-ca tests/marketplace-and-transactions.test.js && npm run test:admin && npm run test:trust && npm run test:threshold && npm run test:operations",
    "test:postman": "node tests/run-postman-collection.js",
    "test:admin": "node tests/admin-dashboard.test.js",
    "test:admin:live": "node --use-system-ca tests/admin-dashboard-live.test.js",
    "test:trust": "node tests/trust-and-records.test.js",
    "test:concurrency": "node --use-system-ca tests/purchase-concurrency.test.js",
    "test:threshold": "node tests/emissions-threshold.test.js",
    "test:operations": "node tests/admin-operations.test.js",
    "test:browser": "node --use-system-ca tests/browser-chart.test.js",
    "test:browser:install": "node --use-system-ca node_modules/playwright/cli.js install chromium",
    "audit:pages": "node --use-system-ca tests/audit-pages.mjs",
    "test:network": "node tests/api-client-network.test.js",
    "test:concurrency:local": "node tests/run-local-concurrency.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.4.7",
    "express": "4.22.3",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "lighthouse": "^13.6.0",
    "playwright": "^1.64.1",
    "puppeteer-core": "^25.16.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
